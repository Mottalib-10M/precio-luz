---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/electricity-price/" title="Spain electricity price today with taxes" width="100%" height="1500" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Spain electricity price calculator – Precio Luz Real" description="Copy the code and paste today’s and tomorrow’s PVPC price with taxes into your site. Expat forums, blogs and local news sites use it free of charge, with a visible link." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the electricity price calculator</h1>
    <p class="mt-3 text-lg text-navy-700">Copy the code and paste it into your page. It updates itself every evening with Red Eléctrica’s price.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link under the calculator must stay visible, the calculator must not be altered and it comes without warranty. Spanish version: <code>{`${SITE_URL}/embed/precio-luz/`}</code>.</p>
    <p><a href={route('contact', lang)}>Contact</a></p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/electricity-price/" title="Spain electricity price today with taxes" width="100%" height="1500" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
