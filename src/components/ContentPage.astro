---
/**
 * Render de una guía o de una página herramienta definida en `src/content/`. Orden (RECETTE §9.3, §21):
 * H1 y entradilla; herramienta: la calculadora, luego el bloque citable plegado; guía: el bloque citable,
 * luego el mini-simulador, luego el cuerpo. FAQ, páginas relacionadas, fuentes y firma vienen del
 * PageLayout, con la FAQ mostrada y marcada desde la misma lista (§7).
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import PrecioCalc from './calc/PrecioCalc';
import AparatoCalc from './calc/AparatoCalc';
import FacturaCalc from './calc/FacturaCalc';
import PotenciaCalc from './calc/PotenciaCalc';
import BonoCalc from './calc/BonoCalc';
import HistorialCalc from './calc/HistorialCalc';
import CuartosCalc from './calc/CuartosCalc';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById } from '../lib/guides';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import { bundle } from '../lib/bundle';
import { media30, MESES } from '../lib/referencias';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef } from '../lib/guide-types';
interface Props { page: PageDef; lang: Locale }
const { page, lang } = Astro.props;
const x = page[lang];
const ui = t(lang);
const path = route(page.id, lang);
const H = helpers(lang);
const parts = x.body(H).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const resume = x.resume(H);
const faqs = x.faqs(H);
const jsonLd = [articleSchema({ title: x.h1, description: x.description, path, lang }), webPageSchema({ name: x.h1, description: x.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: x.nav, path }])];
if (page.tool) jsonLd.push(webApplicationSchema({ name: x.h1, description: x.description, path, lang }));
if (faqs.length) jsonLd.push(faqSchema(faqs, lang));
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id, lang), description: pageById(id)?.[lang].card ?? '' }));
const sources = page.sources.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const methodHref = route('method', lang);
const miniHref = route(page.miniHref ?? 'home', lang);
const tp = page.toolProps ?? {};
const datos = bundle({ cuartos: page.tool === 'cuartos' });
const libre = media30();
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} related={related} sources={sources} breadcrumbs={[{ label: x.nav }]}>
  <article>
    <header class="mb-3">
      <h1 class="text-2xl font-bold text-navy-900 md:text-3xl">{x.h1}</h1>
      <p class="mt-1 text-base text-navy-700 md:text-lg">{x.intro}</p>
    </header>
    {page.tool ? (
      <>
        <Clamp text={resume} lang={lang} id={`clamp-${page.id}`} class="mb-3" />
        <div data-outil>
          {page.tool === 'precio' && <PrecioCalc client:load lang={lang} mode={(tp.mode as 'hoy') ?? 'hoy'} datos={datos} methodHref={methodHref} />}
          {page.tool === 'aparato' && <AparatoCalc client:load lang={lang} aparato={(tp.aparato as 'lavadora') ?? 'generico'} datos={datos} precioLibre={libre} methodHref={methodHref} />}
          {page.tool === 'factura' && <FacturaCalc client:load lang={lang} mode={(tp.mode as 'factura') ?? 'factura'} datos={datos} precioLibre={libre} methodHref={methodHref} />}
          {page.tool === 'potencia' && <PotenciaCalc client:load lang={lang} datos={datos} methodHref={methodHref} />}
          {page.tool === 'bono' && <BonoCalc client:load lang={lang} datos={datos} methodHref={methodHref} />}
          {page.tool === 'historial' && <HistorialCalc client:load lang={lang} meses={MESES} methodHref={methodHref} />}
          {page.tool === 'cuartos' && <CuartosCalc client:load lang={lang} datos={datos} methodHref={methodHref} />}
        </div>
      </>
    ) : (
      <>
        <Clamp text={resume} lang={lang} id={`clamp-${page.id}`} class="mb-3" />
        {page.mini && <MiniSim client:load kind={page.mini} lang={lang} href={miniHref} />}
      </>
    )}
    <p class="mt-2 text-sm text-navy-600" data-chrome>{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method', lang)}</a></p>
    <div class="prose prose-slate max-w-none">
      {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <MiniSim client:load kind={p} lang={lang} href={miniHref} />)}
    </div>
  </article>
</PageLayout>
